{
  "name": "nextn",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "mcp": "npx tsx mcp-server.ts",
    "preview": "opennextjs-cloudflare build && npm run cf:prune-assets && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && npm run cf:prune-assets && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && npm run cf:prune-assets && opennextjs-cloudflare upload",
    "cf:prune-assets": "node -e \"const fs=require('fs'),path=require('path');const max=24*1024*1024;function walk(d){for(const e of fs.readdirSync(d,{withFileTypes:true})){const p=path.join(d,e.name);if(e.isDirectory())walk(p);else{const s=fs.statSync(p).size;if(s>max){console.log('prune',p,(s/1024/1024).toFixed(1)+'MiB');fs.unlinkSync(p);}}}};const root='.open-next/assets';if(fs.existsSync(root))walk(root);\"",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opennextjs/cloudflare": "^1.20.2",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-label": "^2.1.2",
    "@radix-ui/react-popover": "^1.1.6",
    "@radix-ui/react-progress": "^1.1.2",
    "@radix-ui/react-select": "^2.1.6",
    "@radix-ui/react-slider": "^1.2.3",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-toast": "^1.2.6",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.99.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html2pdf.js": "^0.14.0",
    "i18n-iso-countries": "^7.14.0",
    "lucide-react": "^0.475.0",
    "mammoth": "^1.12.0",
    "maplibre-gl": "^5.24.0",
    "next": "^16.2.12",
    "pdf-parse": "^1.1.1",
    "posthog-js": "^1.363.5",
    "posthog-node": "^5.21.2",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-easy-crop": "^5.5.6",
    "react-svg-worldmap": "^2.0.2",
    "recharts": "^2.15.1",
    "resend": "^6.9.4",
    "tailwind-merge": "^3.0.1",
    "tailwindcss-animate": "^1.0.7",
    "word-extractor": "^1.0.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-react": "^7.28.5",
    "@babel/preset-typescript": "^7.28.5",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.4",
    "@types/react": "^19.2.1",
    "@types/react-dom": "^19.2.1",
    "dotenv": "^16.6.1",
    "playwright": "^1.59.1",
    "postcss": "^8",
    "puppeteer": "^24.42.0",
    "tailwindcss": "^3.4.1",
    "typescript": "5.9.3",
    "wrangler": "^4.115.0"
  }
}
