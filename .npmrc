# Silence npm 11's allow-scripts advisory on Cloudflare Pages builds.
# These 7 packages have legitimate install scripts (native binaries, chromium download).
# Approving them explicitly removes the warning without blocking any other scripts.
allow-scripts[]=core-js
allow-scripts[]=esbuild
allow-scripts[]=protobufjs
allow-scripts[]=puppeteer
allow-scripts[]=sharp
allow-scripts[]=workerd
