{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cvinbio-render",
  "main": "worker-render.mjs",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "minify": true,
  "workers_dev": false,
  "preview_urls": false,
  "assets": {"directory": ".open-next/assets", "binding": "ASSETS", "run_worker_first": true},
  "images": {"binding": "IMAGES"},
  "services": [{"binding": "WORKER_SELF_REFERENCE", "service": "cvinbio"}],
  "d1_databases": [{"binding": "NEXT_TAG_CACHE_D1", "database_name": "cvinbio-cache-tags", "database_id": "3200328a-ff85-40b9-ba0b-334bcaa8112b"}],
  "durable_objects": {"bindings": [
    {"name": "APP_RENDERER", "class_name": "AppRenderer"},
    {"name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler"}
  ]},
  "migrations": [{"tag": "render-v1", "new_sqlite_classes": ["AppRenderer", "DOQueueHandler"]}],
  "vars": {"NEXT_CACHE_DO_QUEUE_MAX_REVALIDATION": "1", "NEXT_CACHE_DO_QUEUE_MAX_RETRIES": "2"},
  "observability": {"enabled": true, "head_sampling_rate": 0.1}
}
