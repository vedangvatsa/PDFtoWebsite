{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cvinbio",
  "main": "worker.mjs",
  "minify": true,
  "compatibility_date": "2025-12-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "cvinbio"
    }
  ],
  "d1_databases": [
    {
      "binding": "NEXT_TAG_CACHE_D1",
      "database_name": "cvinbio-cache-tags",
      "database_id": "3200328a-ff85-40b9-ba0b-334bcaa8112b"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
      { "name": "APP_RENDERER", "class_name": "AppRenderer", "script_name": "cvinbio-render" },
      { "name": "PARSER_RENDERER", "class_name": "ParserRenderer", "script_name": "cvinbio-parser" },
      { "name": "IMAGE_RENDERER", "class_name": "ImageRenderer", "script_name": "cvinbio-images" }
    ]
  },
  "migrations": [{ "tag": "cache-v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  "vars": {
    "NEXT_CACHE_DO_QUEUE_MAX_REVALIDATION": "1",
    "NEXT_CACHE_DO_QUEUE_MAX_RETRIES": "2"
  },
  "images": {
    "binding": "IMAGES"
  },
  "routes": [
    { "pattern": "cvin.bio", "custom_domain": true },
    { "pattern": "www.cvin.bio", "custom_domain": true }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
