{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cvinbio-images",
  "main": "worker-images.mjs",
  "compatibility_date": "2025-12-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "minify": true,
  "workers_dev": false,
  "preview_urls": false,
  "assets": {"directory": ".open-next/assets", "binding": "ASSETS", "run_worker_first": true},
  "services": [{"binding": "WORKER_SELF_REFERENCE", "service": "cvinbio"}],
  "d1_databases": [{"binding": "NEXT_TAG_CACHE_D1", "database_name": "cvinbio-cache-tags", "database_id": "3200328a-ff85-40b9-ba0b-334bcaa8112b"}],
  "observability": {"enabled": true, "head_sampling_rate": 0.1}
}
